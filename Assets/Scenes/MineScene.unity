      hole: 1
      isCustomHole: 1
      finger: 1
      triggerEvent:
        m_PersistentCalls:
          m_Calls: []
    - mascot: 1
      message: Old copper blade? Really? Not what I expected to see, but still better
        than bare hands
      replica: {fileID: 8300000, guid: 0f721dffb1f5502419d1aed5f1a272d4, type: 3}
      lookObject: {fileID: 4214988657985799855}
      hole: 0
      isCustomHole: 0
      finger: 0
      triggerEvent:
        m_PersistentCalls:
          m_Calls: []
    - mascot: 0
      message: "We\u2019ll hardly kill anyone with this, but at least will ruin their
        health. Let's take a look at the armor."
      replica: {fileID: 0}
      lookObject: {fileID: 4905371698984710295}
      hole: 1
      isCustomHole: 1
      finger: 1
